<Window x:Class="PandocBetterUse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PandocBetterUse"
        mc:Ignorable="d"
        Title="Pandoc 文档转换工具" 
        Height="520" 
        Width="800"
        WindowStartupLocation="CenterScreen"
        FontSize="14">

    <Window.Resources>
        <!-- 圆角按钮样式 -->
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0056B3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#004085"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#6C757D"/>
                                <Setter Property="Foreground" Value="#ADB5BD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" Opacity="0.2" BlurRadius="4"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次要按钮样式 -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="Foreground" Value="#212529"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E2E6EA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#D4D9DF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 输入框样式 -->
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#212529"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#80BDFF"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#0078D7"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 下拉框样式 -->
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#212529"/>
        </Style>

        <!-- 标签样式 -->
        <Style TargetType="Label">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Foreground" Value="#343A40"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Background="#F8F9FA">
        <!-- 主布局 -->
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题区域 -->
            <Border Grid.Row="0" 
                    Background="{StaticResource PrimaryBrush}" 
                    CornerRadius="10" 
                    Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" 
                            VerticalAlignment="Center" 
                            Margin="20,15">
                    <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" 
                          Fill="White" 
                          Stretch="Uniform" 
                          Width="24" 
                          Height="24" 
                          Margin="0,0,15,0"/>
                    <TextBlock Text="Pandoc 文档转换工具" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="White"/>
                </StackPanel>
            </Border>

            <!-- 设置区域 -->
            <Border Grid.Row="1" 
                    Background="White" 
                    CornerRadius="10" 
                    Padding="25">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 输入文件 -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" 
                               Content="输入文件:" 
                               VerticalAlignment="Center"
                               Width="100"/>

                        <TextBox x:Name="InputFileTextBox" 
                                 Grid.Column="1" 
                                 VerticalAlignment="Center"/>

                        <Button x:Name="BrowseInputButton" 
                                Grid.Column="2" 
                                Content="浏览..." 
                                Style="{StaticResource SecondaryButton}"
                                Click="BrowseInputButton_Click"
                                Width="80"/>
                    </Grid>

                    <!-- 输入格式 -->
                    <Grid Grid.Row="1" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" 
                               Content="输入格式:" 
                               VerticalAlignment="Center"
                               Width="100"/>

                        <ComboBox x:Name="InputFormatComboBox" 
                                  Grid.Column="1" 
                                  VerticalAlignment="Center"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="markdown"/>
                            <ComboBoxItem Content="html"/>
                            <ComboBoxItem Content="latex"/>
                            <ComboBoxItem Content="rst"/>
                            <ComboBoxItem Content="textile"/>
                            <ComboBoxItem Content="docx"/>
                            <ComboBoxItem Content="pptx"/>
                        </ComboBox>
                    </Grid>

                    <!-- 输出目录 -->
                    <Grid Grid.Row="2" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" 
                               Content="输出目录:" 
                               VerticalAlignment="Center"
                               Width="100"/>

                        <TextBox x:Name="OutputFolderTextBox" 
                                 Grid.Column="1" 
                                 VerticalAlignment="Center"/>

                        <Button x:Name="BrowseOutputButton" 
                                Grid.Column="2" 
                                Content="浏览..." 
                                Style="{StaticResource SecondaryButton}"
                                Click="BrowseOutputButton_Click"
                                Width="80"/>
                    </Grid>

                    <!-- 输出格式 -->
                    <Grid Grid.Row="3" Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" 
                               Content="输出格式:" 
                               VerticalAlignment="Center"
                               Width="100"/>

                        <ComboBox x:Name="OutputFormatComboBox" 
                                  Grid.Column="1" 
                                  VerticalAlignment="Center"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="docx"/>
                            <ComboBoxItem Content="html"/>
                            <ComboBoxItem Content="pdf"/>
                            <ComboBoxItem Content="latex"/>
                            <ComboBoxItem Content="rst"/>
                            <ComboBoxItem Content="markdown"/>
                            <ComboBoxItem Content="pptx"/>
                            <ComboBoxItem Content="epub"/>
                        </ComboBox>
                    </Grid>

                    <!-- 状态信息区域 -->
                    <Border Grid.Row="4" 
                            Background="#F1F3F5" 
                            CornerRadius="8" 
                            Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" 
                                       Text="当前配置" 
                                       FontWeight="Bold" 
                                       FontSize="16" 
                                       Margin="0,0,0,10"/>

                            <WrapPanel Grid.Row="1" Orientation="Horizontal">
                                <Border Background="#E9ECEF" 
                                        CornerRadius="6" 
                                        Padding="10,5" 
                                        Margin="0,0,10,0">
                                    <TextBlock x:Name="StatusInputFileText" 
                                               Text="📄 输入文件: 未选择"/>
                                </Border>

                                <Border Background="#E9ECEF" 
                                        CornerRadius="6" 
                                        Padding="10,5" 
                                        Margin="0,0,10,0">
                                    <TextBlock x:Name="StatusInputFormatText" 
                                               Text="📝 输入格式: markdown"/>
                                </Border>

                                <Border Background="#E9ECEF" 
                                        CornerRadius="6" 
                                        Padding="10,5" 
                                        Margin="0,0,10,0">
                                    <TextBlock x:Name="StatusOutputFolderText" 
                                               Text="📁 输出目录: 桌面"/>
                                </Border>

                                <Border Background="#E9ECEF" 
                                        CornerRadius="6" 
                                        Padding="10,5">
                                    <TextBlock x:Name="StatusOutputFormatText" 
                                               Text="🎯 输出格式: docx"/>
                                </Border>
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 底部按钮区域 -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 状态指示 -->
                <Border Grid.Column="1" 
            Background="#E9ECEF" 
            CornerRadius="6" 
            Padding="12,8" 
            Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusIndicator" 
                     Width="12" 
                     Height="12" 
                     Fill="{StaticResource PrimaryBrush}" 
                     Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText" 
                       Text="就绪" 
                       VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 刷新格式按钮 -->
                <Button x:Name="RefreshFormatsButton" 
            Grid.Column="2" 
            Content="🔄 刷新格式" 
            Style="{StaticResource SecondaryButton}"
            Click="RefreshFormatsButton_Click"
            Width="120"
            Margin="0,0,10,0"
            ToolTip="重新加载 input.ini 和 output.ini 中的格式列表"/>

                <Button x:Name="SaveConfigButton" 
            Grid.Column="3" 
            Content="💾 保存配置" 
            Style="{StaticResource SecondaryButton}"
            Click="SaveConfigButton_Click"
            Width="120"
            Margin="0,0,10,0"/>

                <Button x:Name="PreviewButton" 
            Grid.Column="4" 
            Content="👁️ 预览" 
            Style="{StaticResource SecondaryButton}" 
            Margin="0,0,10,0"
            Click="PreviewButton_Click"
            Width="100"/>

                <Button x:Name="ConvertButton" 
            Grid.Column="5" 
            Content="🚀 开始转换" 
            Style="{StaticResource RoundedButton}"
            Click="ConvertButton_Click"
            Width="140"/>
            </Grid>
        </Grid>
    </Grid>
</Window>