<Application x:Class="PandocBetterUse.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- 颜色资源 -->
        <Color x:Key="PrimaryColor">#0078D7</Color>
        <Color x:Key="SuccessColor">#28A745</Color>
        <Color x:Key="ErrorColor">#DC3545</Color>
        <Color x:Key="WarningColor">#FFC107</Color>

        <!-- 将Color转换为SolidColorBrush -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>

        <!-- 字体 -->
        <FontFamily x:Key="AppFont">Segoe UI, Microsoft YaHei</FontFamily>

        <!-- 全局样式 -->
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        </Style>
    </Application.Resources>
</Application>